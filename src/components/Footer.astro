---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__col">
      <h4>Britto Lab</h4>
      <p class="muted">
        Department of Chemistry<br />
        Indian Institute of Science Education and Research (IISER) Pune
      </p>
    </div>

    <div class="site-footer__col">
      <h4>Contact</h4>
      <p class="muted">
        C127C &amp; C128, Main Building, Chemistry Department,<br />
        Indian Institute of Science Education and Research Pune,<br />
        Dr. Homi Bhabha Road, Pashan, Pune 411008, Maharashtra, India.
      </p>
      <p class="muted">
        +91-20-25908223<br />
        <a href="mailto:sandanaraj.britto@iiserpune.ac.in">sandanaraj.britto@iiserpune.ac.in</a>
      </p>
      <a class="text-link" href="https://maps.app.goo.gl/BcbPr4Frgm5gUkor6" target="_blank" rel="noopener">Google Maps →</a>
    </div>

    <div class="site-footer__col">
      <h4>Profiles</h4>
      <ul class="site-footer__links">
        <li><a href="https://www.linkedin.com/in/britto2k/" target="_blank" rel="noopener">https://www.linkedin.com/in/britto2k/</a></li>
      </ul>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p class="muted">© {year} Britto Lab, IISER Pune</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy);
    color: var(--color-white);
    padding: 64px 0 24px;
  }
  .site-footer h4 {
    color: var(--color-white);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .site-footer .muted { color: rgba(255,255,255,0.62); }
  .site-footer a { color: rgba(255,255,255,0.85); }
  .site-footer a:hover { color: var(--color-teal); }

  .site-footer__inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(255,255,255,0.12);
  }

  .site-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .site-footer__links a { word-break: break-word; font-size: 0.92rem; }

  .site-footer__bottom {
    padding-top: 24px;
  }
  .site-footer__bottom p { margin: 0; font-size: 0.85rem; }

  @media (max-width: 720px) {
    .site-footer__inner { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
